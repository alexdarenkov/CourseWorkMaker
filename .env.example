# --- Безопасность ---
# Секрет для подписи JWT (HS256). Минимум 32 байта. Сгенерируйте свой: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# --- PostgreSQL (одна база на монолит: таблицы users и documents) ---
POSTGRES_USER=coursework
POSTGRES_PASSWORD=coursework
POSTGRES_DB=coursework

# --- ИИ (прокси Polza.ai, OpenAI-совместимый API: https://polza.ai/docs/gaidy) ---
AI_API_KEY=sk-...
AI_BASE_URL=https://polza.ai/api/v1
# Модели уровней «скорость/качество» (пользователь видит только уровень и цену):
#AI_MODEL_FAST=google/gemini-2.5-flash
#AI_MODEL_BALANCED=openai/gpt-5-mini
#AI_MODEL_QUALITY=anthropic/claude-sonnet-4.6
